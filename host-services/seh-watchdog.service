[Unit]
Description=Simply Energy Home — Update Watchdog (auto-rollback si MAJ KO)
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/seh-watchdog.py
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

# Sécurité
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/seh /opt/seh /var/log
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
